# Django Environment Variables Configuration Example for cPanel / Production

# Security & Debug
SECRET_KEY=your-production-secret-key-here
DEBUG=False

ALLOWED_HOSTS=helplinehellonaogaon.com,www.helplinehellonaogaon.com,mail.helplinehellonaogaon.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://helplinehellonaogaon.com,https://www.helplinehellonaogaon.com

# Database Configuration (MySQL for cPanel example)
# Format: mysql://username:password@localhost:3306/database_name
# Default: sqlite:////path/to/db.sqlite3
DATABASE_URL=mysql://cpanel_user:cpanel_password@localhost:3306/cpanel_dbname

# HTTPS & Security (Recommended for production with SSL)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Static & Media Directories (Optional overrides)
STATIC_URL=/static/
STATIC_ROOT=/home/username/public_html/static
MEDIA_URL=/media/
MEDIA_ROOT=/home/username/public_html/media

# Email Configuration (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.helplinehellonaogaon.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=info@helplinehellonaogaon.com
EMAIL_HOST_PASSWORD=your_email_password_here
DEFAULT_FROM_EMAIL=info@helplinehellonaogaon.com
SERVER_EMAIL=admin@helplinehellonaogaon.com

# Automas Bulk SMS Gateway Configuration
AUTOMAS_API_KEY=your_automas_api_key_here
AUTOMAS_SENDER_ID=your_sender_id_here
AUTOMAS_API_URL=https://api.automas.com.bd/smsapiv3
SMS_ADMIN_ALERT_PHONE=01916314315
SMS_LOW_BALANCE_THRESHOLD=10.0

# UddoktaPay / Paymently Payment Gateway Configuration
PAYMENTLY_API_KEY=your_paymently_api_key_here
PAYMENTLY_API_URL=https://helplinehellonaogaon.paymently.io/api

# PayStation Payment Gateway Configuration (100% Direct OTP/PIN)
PAYSTATION_MERCHANT_ID=your_paystation_merchant_id
PAYSTATION_PASSWORD=your_paystation_password
PAYSTATION_IS_SANDBOX=False
ACTIVE_PAYMENT_GATEWAY=paystation
